# Backend (apps/api) — set these on Render, or in apps/api/.env locally.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Leave GROQ_API_KEY empty to use the deterministic template fallback.
# GROQ_MODEL is required when a key is set. It must support json_schema structured output,
# for example openai/gpt-oss-20b (check console.groq.com/docs/structured-outputs).
GROQ_API_KEY=
GROQ_MODEL=
# Browser origin allowed by CORS (the Netlify URL in production).
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3001

# Frontend (apps/web) — set on Netlify, or in apps/web/.env.local locally.
# Public by design: never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:3001
